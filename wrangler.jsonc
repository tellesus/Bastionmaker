{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bastionmaker",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bastionmaker",
      "database_id": "174f8218-a975-4d7d-a567-9222439b4ecc"
    }
  ],
  "routes": [{ "pattern": "bastions.nextfic.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
